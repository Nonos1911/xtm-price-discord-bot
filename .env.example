# Ne mets jamais le token dans le dépôt ni dans le chat.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=1370700962695610430
ALERT_CHANNEL_ID=1163364187796426776
ALERT_THRESHOLD_PERCENT=10
# Seuil haussier autorisé : 10, 20, 30 ou 40. Le seuil baissier reste à -10 %.
ALERTS_PAUSED=false
# true met en pause les alertes (sans supprimer les boxes existantes).
ALERT_REPEAT_COUNT=5
ALERT_INTERVAL_SECONDS=60

# IDs CoinGecko : XTM = MinoTari, wXTM = Wrapped MinoTari ; prix wXTM via son pool Uniswap.
COINS=minotari:XTM:MEXC,wrapped-minotari:wXTM:Uniswap V4
INTERVAL_MINUTES=5

# Facultatif mais recommandé pour une utilisation durable.
# COINGECKO_API_KEY=
# COINGECKO_API_PLAN=demo
